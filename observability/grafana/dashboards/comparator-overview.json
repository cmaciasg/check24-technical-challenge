    {
      "id": 18,
      "type": "heatmap",
      "title": "Heatmap de duración",
      "description": "Muestra la forma real: un bloque ancho entre 1,2 y 1,8 s (B) y un segundo bloque en ≈ 2 s cuando C hace un pico. Es lo que una media no deja ver.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "fieldConfig": {
