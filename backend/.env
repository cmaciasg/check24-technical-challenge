###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-real-deployments
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

# Providers simulados: el backend se llama a sí mismo por HTTP de loopback.
PROVIDERS_BASE_URL=http://127.0.0.1:8000

# Campaña de marketing (product.md §4.1). discount_type: PERCENTAGE | FIXED_AMOUNT (céntimos).
MARKETING_CAMPAIGN_ACTIVE=false
MARKETING_CAMPAIGN_DISCOUNT_TYPE=PERCENTAGE
MARKETING_CAMPAIGN_DISCOUNT_VALUE=10

# Almacén de métricas: `apcu` en ejecución real con PHP-FPM, `memory` en tests y desarrollo sin APCu.
METRICS_STORAGE=memory

# Solo para el stack de test con servidor real (testing.md §3.4). Vacío = comportamiento aleatorio normal.
# Ejemplos: SIMULATION_FORCE="provider-c=http_error"  SIMULATION_LATENCY_MS="provider-b=1800"
SIMULATION_FORCE=
SIMULATION_LATENCY_MS=
